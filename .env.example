# Meridian Academy RAG — environment template.
#
#   copy .env.example .env      (Windows)      cp .env.example .env   (unix)
#
# Every variable the system reads is listed here with its default. All are
# optional except SCALER_LLM_API_KEY. Values shown are the defaults baked into
# rag/config.py — uncomment a line only to override it.
#
# Section references are to DESIGN.md, which is the specification.


# =============================================================================
# LLM — required
# =============================================================================

# The one key the brief provides. Used for answer generation, query expansion,
# and the evaluation judge. Never logged, never written to a trace.
SCALER_LLM_API_KEY=

# Which provider that key belongs to. "auto" inspects the key prefix: a key
# starting "sk-ant-" is Anthropic, anything else is OpenAI (DESIGN.md §a.3
# decision 8). Set explicitly to remove the guess.
#   auto | anthropic | openai
#LLM_PROVIDER=auto

# Model id. Left blank, the client picks the default for the resolved provider
# (Anthropic: claude-opus-5). Set this to pin a specific model.
#LLM_MODEL=

# Reasoning effort for the answering call. This is a grounded extraction task
# over ~1,500 tokens of supplied context, not open-ended reasoning, so "medium"
# is the cost/quality sweet spot; raise to "high" if faithfulness (DESIGN.md
# §f.2 metric 3) drops. Anthropic path only; ignored on OpenAI.
#   low | medium | high
#LLM_EFFORT=medium

# Hard ceiling on generated tokens. Answers are 2-6 sentences (§d.1 STYLE), so
# this is generous headroom, not a target.
#LLM_MAX_TOKENS=2048

# Per-request timeout in seconds, before retries.
#LLM_TIMEOUT_S=60

# NOTE: there is deliberately no temperature setting. Current Anthropic models
# reject sampling parameters outright, so the Anthropic path must never send
# one. The judge's determinism comes from structured output plus a rubric, not
# from temperature (§f.2).


# =============================================================================
# Embeddings — DESIGN.md §c.1
# =============================================================================

# "auto" tries fastembed (BAAI/bge-small-en-v1.5, 384-dim, ONNX/CPU) and falls
# back to the dependency-free TF-IDF/LSA embedder if the package is missing or
# the one-time model download fails. An explicit value fails loudly instead of
# silently downgrading — the trace records which backend actually ran.
#   auto | fastembed | local | openai
#EMBEDDING_BACKEND=auto

# "openai" is opt-in only and requires an OpenAI key; it is never auto-selected,
# because SCALER_LLM_API_KEY may well be an Anthropic key.
#OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# =============================================================================
# Paths
# =============================================================================

# Source documents. Read-only; never written to.
#CORPUS_DIR=corpus

# Generated index: rag.db (chunks + FTS5 + traces) and vectors.npy. Gitignored,
# and rebuildable at any time with `python main.py --ingest --force`.
#INDEX_DIR=index

# traces.jsonl lands here. Gitignored.
#LOGS_DIR=logs


# =============================================================================
# Chunking — DESIGN.md §b.3
# =============================================================================

# Max chunk size in characters (~300 tokens). Large enough for one complete
# policy clause plus its worked example; small enough that a top-5 context stays
# around 1,500 tokens.
#MAX_CHARS=1200

# Overlap applied ONLY when a structural unit must be force-split (~15%). Enough
# to carry a sentence subject across the seam so a boundary-spanning fact is
# recoverable from either side.
#OVERLAP_CHARS=180

# Below this a unit is usually a stray heading or one-line clause that embeds
# noisily; such units are merged forward rather than indexed alone.
#MIN_CHARS=220


# =============================================================================
# Retrieval — DESIGN.md §c.4
# =============================================================================

# Chunks each arm (dense, BM25) contributes to fusion.
#CANDIDATES_PER_ARM=20

# Chunks passed to the model after fusion. Tuned against the context-precision
# metric in §f.2; above ~6 precision falls and the model starts citing
# marginally-relevant sources.
#TOP_K=5

# Reciprocal Rank Fusion constant. The standard published value; not tuned, and
# not worth tuning on 12 eval cases (§f.3).
#RRF_K=60

# --- miss detection ----------------------------------------------------------
# There is deliberately NO MIN_FUSED_SCORE. Both arms always return their top-N
# regardless of relevance, so a fused RRF score measures agreement between arms,
# never absolute relevance — a floor on it cannot detect a miss. Miss detection
# instead inspects each arm's RAW signal before fusion (§c.4).

# Dense condition: the top raw cosine is below this floor.
# PROVISIONAL — calibrate in Step 13 by comparing top_score on the abstention
# cases (§f.1 cases 10-11) against the answerable ones and placing the floor
# between the two clusters. Every query logs top_score, so this is re-calibrated
# from traces rather than guessed twice.
#MISS_DENSE_COSINE=0.75

# Sparse condition: FTS5 matched no non-stopword term of the query, or the top
# BM25 score is below this floor. PROVISIONAL, same calibration path.
#MISS_BM25_FLOOR=1.0

# A hard miss requires BOTH conditions, and short-circuits with no LLM call
# at all (§d.3).


# =============================================================================
# Authority ordering — DESIGN.md §c.6
# =============================================================================

# Multiplier applied to a chunk's fused score when that chunk explicitly defers
# to a document already present in the same result set. It REORDERS, never
# filters — both chunks remain retrievable and both remain citable.
#AUTHORITY_PENALTY=0.8


# =============================================================================
# Feature flags
# =============================================================================

# LLM query expansion (§c.5): rewrites the question into corpus vocabulary for
# the sparse arm only. Cached, short-timeout, and fails open — on any error the
# raw query is used. Set to 0 to remove one LLM call per query.
#ENABLE_QUERY_EXPANSION=1

# Log the full prompt text in every trace. Off by default: the prompt is large
# and repetitive, so traces carry prompt_sha256 plus a token estimate, which is
# enough to prove two runs sent identical prompts (§e.1).
#TRACE_FULL_PROMPT=0
